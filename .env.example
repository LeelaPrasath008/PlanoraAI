# GEMINI_API_KEY: Server-side Google Gemini API key (optional in demo mode; fallback engine activates if unset)
GEMINI_API_KEY=""

# Server Configuration (optional overrides with safe defaults)
PORT="3000"
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
AI_CACHE_TTL_MS="300000"
AI_CACHE_MAX_ENTRIES="100"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_GENERAL="60"
RATE_LIMIT_MAX_HEAVY="20"
