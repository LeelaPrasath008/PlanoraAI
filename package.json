{
  "name": "planora-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . && tsc --noEmit",
    "format": "eslint . --fix",
    "test": "NODE_ENV=test tsx --test firestore.rules.test.ts src/__tests__/*.test.ts && vitest run",
    "test:unit": "NODE_ENV=test tsx --test firestore.rules.test.ts src/__tests__/*.test.ts",
    "test:ui": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore 'npm run test:rules:run'",
    "test:rules:run": "NODE_ENV=test tsx --test firestore.rules.test.ts",
    "test:coverage": "NODE_ENV=test tsx --test --experimental-test-coverage firestore.rules.test.ts src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.21",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
